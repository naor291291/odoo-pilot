# Staxa injects these five values after PostgreSQL is enabled. Do not commit values.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# DATABASE_URL is used only if NONE of the five DB_* values is set.
# DATABASE_URL=
# Require encrypted DB transport by default. Confirm provider support/CA first.
DB_SSLMODE=require
# Generate privately, >=32 chars. This is the database-management secret, not user login.
ODOO_ADMIN_PASSWORD=
# serve never initializes/upgrades a database. init is an explicit one-off on a NEW DB.
STAXA_ODOO_MODE=serve
PORT=8069

{$CRM_DOMAIN} {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
    }
    @database path /web/database /web/database/*
    respond @database 404
    @webhook path /field-work/whatsapp/webhook
    request_body @webhook {
        max_size 256KB
    }
    @websocket path /websocket /websocket/*
    reverse_proxy @websocket odoo:8072
    reverse_proxy odoo:8069
}

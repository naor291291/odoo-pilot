<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_entitlement_company" model="ir.rule">
        <field name="name">Contractor entitlement: active allowed companies</field><field name="model_id" ref="model_field_work_entitlement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_statement_company" model="ir.rule">
        <field name="name">Contractor statement: active allowed companies</field><field name="model_id" ref="model_field_contractor_statement"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('create_uid', '=', user.id)]</field>
    </record>
    <record id="access_entitlement_owner" model="ir.model.access">
        <field name="name">Contractor entitlement owner read only</field><field name="model_id" ref="model_field_work_entitlement"/>
        <field name="group_id" ref="group_field_finance"/><field name="perm_read">True</field>
    </record>
    <record id="access_statement_owner" model="ir.model.access">
        <field name="name">Contractor statement owner</field><field name="model_id" ref="model_field_contractor_statement"/>
        <field name="group_id" ref="group_field_finance"/><field name="perm_read">True</field><field name="perm_write">True</field>
        <field name="perm_create">True</field><field name="perm_unlink">True</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TransientModel uses normal ACL/rules in the installed Odoo 18 build.
         A finance dialog must not become a second, less-restricted ledger. -->
    <record id="rule_payment_register_private" model="ir.rule">
        <field name="name">Payment dialog: creator, company and financial role</field>
        <field name="model_id" ref="model_field_work_payment_register"/>
        <field name="domain_force">[('create_uid', '=', user.id), ('lead_id.company_id', 'in', company_ids)] + ([] if user.has_group('field_work_photos.group_field_finance') else [('kind', '=', 'customer')])</field>
    </record>
    <record id="rule_payment_cancel_private" model="ir.rule">
        <field name="name">Cancellation dialog: creator, company and financial role</field>
        <field name="model_id" ref="model_field_work_payment_cancel"/>
        <field name="domain_force">[('create_uid', '=', user.id), ('payment_id.company_id', 'in', company_ids)] + ([] if user.has_group('field_work_photos.group_field_finance') else [('payment_id.kind', '=', 'customer')])</field>
    </record>
    <record id="rule_correction_private" model="ir.rule">
        <field name="name">Correction dialog: creator and company</field>
        <field name="model_id" ref="model_field_work_correction"/>
        <field name="domain_force">[('create_uid', '=', user.id), '|', ('task_id.company_id', '=', False), ('task_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_field_payment_company_kind" model="ir.rule">
        <field name="name">Field payments: allowed companies and owner-only payouts</field>
        <field name="model_id" ref="model_field_work_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)] + ([] if user.has_group('field_work_photos.group_field_finance') else [('kind', '=', 'customer')])</field>
    </record>
    <record id="access_field_payment" model="ir.model.access">
        <field name="name">Field payment operators</field><field name="model_id" ref="model_field_work_payment"/>
        <field name="group_id" ref="group_field_dispatcher"/>
        <field name="perm_read">True</field><field name="perm_write">True</field><field name="perm_create">True</field><field name="perm_unlink">False</field>
    </record>
    <record id="access_field_payment_register" model="ir.model.access">
        <field name="name">Field payment registration dialog</field><field name="model_id" ref="model_field_work_payment_register"/>
        <field name="group_id" ref="group_field_dispatcher"/>
        <field name="perm_read">True</field><field name="perm_write">True</field><field name="perm_create">True</field><field name="perm_unlink">True</field>
    </record>
    <record id="access_field_payment_cancel" model="ir.model.access">
        <field name="name">Field payment cancellation dialog</field><field name="model_id" ref="model_field_work_payment_cancel"/>
        <field name="group_id" ref="group_field_dispatcher"/>
        <field name="perm_read">True</field><field name="perm_write">True</field><field name="perm_create">True</field><field name="perm_unlink">True</field>
    </record>
</odoo>

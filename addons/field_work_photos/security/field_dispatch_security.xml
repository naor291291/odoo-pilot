<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_field_dispatcher" model="res.groups">
        <field name="name">ניהול ושיבוץ עבודות שטח</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('project.group_project_user')), (4, ref('field_work_photos.group_field_reviewer'))]"/>
    </record>
    <record id="group_field_contractor" model="res.groups">
        <field name="name">קבלן - פורטל עבודות שטח</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">חשבון פורטל חיצוני בלבד. גישה לעבודות המשויכות דרך /my/field-work, ללא גישה ל-CRM או למסכי ניהול.</field>
    </record>
    <!-- Global restrictions also prevent accidental native project sharing from
         granting contractors a second path to data outside the scoped portal. -->
    <record id="rule_contractor_no_native_tasks" model="ir.rule">
        <field name="name">Field contractor: scoped portal only (tasks)</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[(1, '=', 0)] if user.has_group('field_work_photos.group_field_contractor') else [(1, '=', 1)]</field>
    </record>
    <record id="rule_contractor_no_native_projects" model="ir.rule">
        <field name="name">Field contractor: scoped portal only (projects)</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[(1, '=', 0)] if user.has_group('field_work_photos.group_field_contractor') else [(1, '=', 1)]</field>
    </record>
</odoo>

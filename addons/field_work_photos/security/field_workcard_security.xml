<odoo>
    <record id="access_work_document_ops" model="ir.model.access">
        <field name="name">מסמכי עבודה — תפעול</field><field name="model_id" ref="model_field_work_document"/>
        <field name="group_id" ref="group_field_dispatcher"/><field name="perm_read">1</field><field name="perm_create">1</field><field name="perm_write">0</field><field name="perm_unlink">0</field>
    </record>
    <record id="rule_work_document_company" model="ir.rule">
        <field name="name">מסמכי עבודה בחברות מורשות בלבד</field><field name="model_id" ref="model_field_work_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('lead_id.is_field_service', '=', True)]</field>
    </record>
</odoo>

<odoo>
    <record id="view_field_setup" model="ir.ui.view">
        <field name="name">crm.lead.field.setup.two.screens</field><field name="model">crm.lead</field><field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="פתיחת עבודה" class="o_field_ui">
                <header><button name="action_workcard_setup" type="object" string="שמירה ופתיחת כרטיס העבודה" class="oe_highlight"/></header>
                <sheet><h1>פתיחת עבודה</h1><p>בוחרים לקוח, ממלאים כתובת ותיאור וממשיכים לכרטיס אחד מרוכז.</p>
                    <field name="is_field_service" invisible="1"/><field name="team_id" invisible="1"/>
                    <group><field name="partner_id" required="1"/><field name="name" string="שם העבודה" required="1"/>
                        <field name="field_site_address" required="1"/><field name="field_work_description" required="1"/>
                        <field name="phone"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_field_workcard" model="ir.ui.view">
        <field name="name">crm.lead.field.central.workcard</field><field name="model">crm.lead</field><field name="priority">101</field>
        <field name="arch" type="xml">
            <form string="כרטיס עבודה" class="o_field_ui o_field_central_workcard">
                <header><button name="action_workcard_setup" type="object" string="שמירה ופתיחת כרטיס העבודה" class="oe_highlight" invisible="id"/><button name="action_workcard_dispatch" type="object" string="אישור שיבוץ" class="oe_highlight" invisible="not id or field_dispatch_code in ['completed','paid']"/>
                    <button name="action_submit_field_report" type="object" string="הגשת ביצוע לאישור" invisible="not field_task_count or field_report_state not in ['draft','changes_requested']"/>
                    <button name="action_approve_field_report" type="object" string="אישור ביצוע" invisible="field_report_state != 'pending' or not field_report_can_review or field_visit_result in ['followup','not_done']"/>
                    <button name="action_return_field_report" type="object" string="החזרה לתיקון" invisible="field_report_state not in ['pending','approved'] or not field_report_can_review"/>
                    <button name="action_close_field_work" type="object" string="סגירת עבודה — שולם" invisible="field_dispatch_code != 'completed' or field_collection_status != 'paid'"/>
                </header>
                <sheet>
                    <field name="is_field_service" invisible="1"/><field name="team_id" invisible="1"/><field name="field_dispatch_code" invisible="1"/>
                    <field name="field_report_state" invisible="1"/><field name="field_report_can_review" invisible="1"/><field name="field_task_count" invisible="1"/><field name="field_visit_result" invisible="1"/>
                    <field name="field_collection_status" invisible="1"/><field name="field_pricing_currency_id" invisible="1"/>
                    <group invisible="id" string="פתיחת עבודה"><field name="partner_id" required="not id"/><field name="name" string="שם העבודה"/>
                        <field name="field_site_address" required="not id"/><field name="field_work_description" required="not id"/><field name="phone"/></group>
                    <group col="1" invisible="not id"><label for="workcard_customer" string="לקוח"/><h1><field name="partner_id" id="workcard_customer"/></h1><label for="workcard_title" string="שם העבודה"/><h2><field name="name" id="workcard_title"/></h2>
                    <button name="action_open_field_customer" type="object" string="פתיחת פרטי הלקוח"/><group string="פרטי הלקוח והעבודה"><group><field name="phone"/><field name="contact_name"/><field name="field_site_address"/><field name="field_site_unit"/></group>
                        <group><field name="field_work_description"/><field name="field_access_instructions"/><field name="company_id" groups="base.group_multi_company"/></group></group>
                    <group string="עסקה והצעת מחיר"><field name="field_sale_amount"/><field name="field_quote_number"/>
                        <field name="field_quote_filename" invisible="1"/><button name="action_preview_field_quote" type="object" string="צפייה בהצעה" invisible="not field_quote_pdf"/><field name="field_quote_pdf" filename="field_quote_filename" options="{'accepted_file_extensions': '.pdf'}"/></group>
                    <group string="שיבוץ ומועד ביצוע"><field name="field_execution_type"/><field name="field_worker_id" invisible="field_execution_type != 'direct'"/>
                        <field name="field_contractor_id" invisible="field_execution_type != 'subcontractor'" options="{'no_create': True}"/><field name="field_visit_at"/>
                        <p>שינוי שיבוץ לאחר הגשת ביצוע מחייב החזרה לתיקון כדי לשמור על הדיווח שאושר.</p></group>
                    <group string="הוצאות ועמלת קבלן" groups="field_work_photos.group_field_finance">
                        <p>כל סכומי התמחור לפני מע״מ. הוצאות עסק אחרות אינן כוללות את החומרים שהוזנו בנפרד. הוצאות קבלן אינן מנוכות מבסיס העמלה, ומתווספות להחזר רק לאחר אישור.</p>
                        <group><field name="field_material_cost"/><field name="field_sheet_business_expenses" string="הוצאות עסק אחרות — ללא החומרים"/>
                            <field name="field_sheet_contractor_expenses"/><field name="field_expenses_approved"/></group>
                        <group><field name="field_commission_formula" readonly="1"/><field name="field_commission_base"/><field name="field_applied_rate"/><field name="field_commission_amount"/>
                            <field name="field_contractor_cost"/><field name="field_gross_profit"/><field name="field_gross_margin"/></group>
                        <div class="alert alert-warning" role="alert" invisible="field_commission_base &gt;= 0">בסיס העמלה שלילי. רישום תשלום לקבלן חסום עד להחלטה עסקית.</div>
                    </group>
                    <group string="חשבונית וקישור למסלולי המסמכים הקיימים"><field name="field_invoice_number"/><field name="field_invoice_filename" invisible="1"/>
                        <field name="field_invoice_pdf" filename="field_invoice_filename"/><button name="action_preview_field_invoice" type="object" string="צפייה בחשבונית" invisible="not field_invoice_pdf"/>
                    </group><group string="שליחה ותיעוד"><field name="field_whatsapp_opt_in"/><button name="action_simulate_field_quote" type="object" string="הדמיית שליחת הצעה" invisible="not field_quote_pdf"/>
                        <button name="action_simulate_field_invoice" type="object" string="הדמיית שליחת חשבונית" invisible="not field_invoice_pdf"/>
                        <field name="field_delivery_attempt_ids" readonly="1"><list create="false" edit="false" delete="false">
                            <field name="create_date" string="מועד"/><field name="document_kind"/><field name="document_number"/>
                            <field name="channel"/><field name="status" widget="badge"/></list></field></group><h2>מסמכים והיסטוריה</h2><p>מוסיפים מסמך עם מספר וסכום כולל מע״מ. חשבון עסקה וחשבונית מתייחסים לחוב אחד. רישום קבלה אינו מוחק מסמכים קודמים.</p>
                    <field name="field_document_history_ids" context="{'default_lead_id': id}">
                        <list edit="false" delete="false"><field name="currency_id" column_invisible="True"/><field name="id" column_invisible="True"/><field name="kind" readonly="id"/><field name="number" readonly="id"/><field name="amount_known" readonly="1"/><field name="amount" readonly="id" invisible="id and not amount_known"/>
                            <field name="filename" column_invisible="True"/><field name="pdf" filename="filename" readonly="id"/>
                            <field name="create_date" readonly="1"/><field name="create_uid" readonly="1"/>
                        </list>
                        <form string="הוספת מסמך עבודה" edit="false" delete="false" duplicate="false">
                            <group><field name="lead_id" invisible="1"/><field name="company_id" invisible="1"/><field name="currency_id" invisible="1"/>
                                <field name="kind" readonly="id"/><field name="number" readonly="id"/><field name="amount_known" invisible="1"/>
                                <field name="amount" readonly="id" invisible="id and not amount_known"/>
                                <field name="filename" invisible="1"/><field name="pdf" filename="filename" readonly="id"/>
                            </group><p>הסכום כולל מע״מ. ניתן לצרף PDF ללא סיסמה, עד 8MB. מסמך שנרשם נשמר בהיסטוריה ואינו ניתן להחלפה.</p>
                            <div class="alert alert-info" role="status" invisible="not id or amount_known">במסמך היסטורי זה לא תועד סכום. לא נוצר חוב משוער.</div>
                        </form>
                    </field>
                    <group string="גבייה מהלקוח"><field name="field_customer_due"/><field name="field_customer_paid"/><field name="field_customer_balance"/>
                        <button name="action_register_customer_payment" type="object" string="רישום תשלום מהלקוח" invisible="field_customer_due &lt;= 0 or field_customer_balance &lt;= 0"/>
                        <field name="field_payment_ids" readonly="1"/></group>
                    <group string="תשלומים לקבלן" groups="field_work_photos.group_field_finance"><field name="field_contractor_due"/><field name="field_contractor_amount_approved"/><button name="action_approve_contractor_amount" type="object" string="אישור סכום לקבלן"/><field name="field_contractor_paid"/><field name="field_contractor_balance"/>
                        <button name="action_register_contractor_payment" type="object" string="רישום תשלום לקבלן"/><field name="field_payout_ids" readonly="1"/></group>
                    <h2>תמונות, ביצוע והערות</h2><div class="o_field_photo_grid">
                        <div><label for="field_report_before_image" string="לפני ביצוע"/><field name="field_report_before_image" widget="image" nolabel="1" readonly="not field_task_count or field_report_state in ['pending','approved']"/></div>
                        <div><label for="field_report_after_image" string="אחרי ביצוע"/><field name="field_report_after_image" widget="image" nolabel="1" readonly="not field_task_count or field_report_state in ['pending','approved']"/></div></div>
                    <h3>תמונות נוספות</h3>
                    <field name="field_extra_photo_ids" readonly="1" nolabel="1"><kanban create="false" edit="false" delete="false" class="o_field_extra_gallery">
                        <field name="kind"/><field name="image"/><templates><t t-name="card"><field name="image" widget="image" options="{'size':[200,160]}"/><div><field name="kind"/></div></t></templates>
                    </kanban></field><group><field name="field_visit_result"/><field name="field_visit_summary"/><field name="field_visit_reason"/><field name="field_visit_notes"/><field name="field_report_note"/></group>
                    <group string="מצב עבודה ומעקב"><field name="field_report_state"/><field name="stage_id" readonly="1"/><field name="field_closed_at"/><field name="field_closed_by"/></group></group>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="action_field_service_leads_form" model="ir.actions.act_window.view"><field name="view_id" ref="view_field_workcard"/></record>
    <record id="view_field_kanban_customer_first" model="ir.ui.view">
        <field name="name">field.kanban.customer.first</field><field name="model">crm.lead</field><field name="inherit_id" ref="view_field_lead_kanban"/>
        <field name="arch" type="xml"><xpath expr="//t[@t-name='card']/div[1]" position="replace"><div class="fw-bold fs-5 mb-2"><field name="partner_id"/></div></xpath>
            <xpath expr="//t[@t-name='card']/div[2]" position="replace"><div><field name="name"/></div></xpath></field>
    </record>
    <record id="view_partner_enrol_contractor" model="ir.ui.view">
        <field name="name">res.partner.enrol.field.contractor</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml"><xpath expr="//sheet" position="before"><header><button name="action_enrol_field_contractor" type="object" string="הפעלת פורטל קבלן ושיבוץ" groups="field_work_photos.group_field_finance" confirm="יש לאמת שזה איש הקשר וכתובת הדוא״ל של הקבלן. להפעיל גישת פורטל לעבודות שישויכו אליו בלבד?"/></header></xpath></field>
    </record>
    <record id="view_client_enrol_contractor" model="ir.ui.view">
        <field name="name">res.partner.field.client.enrol.contractor</field><field name="model">res.partner</field><field name="inherit_id" ref="view_field_client_form"/>
        <field name="arch" type="xml"><xpath expr="//button[@name='action_open_field_client_work']" position="after"><button name="action_enrol_field_contractor" type="object" string="הפעלת פורטל קבלן ושיבוץ" groups="field_work_photos.group_field_finance" invisible="not id" confirm="יש לאמת את שם איש הקשר וכתובת הדוא״ל. להפעיל פורטל לעבודות שישויכו אליו בלבד?"/></xpath></field>
    </record>
    <record id="view_rates_enrol_contractor" model="ir.ui.view">
        <field name="name">res.partner.field.rates.enrol.contractor</field><field name="model">res.partner</field><field name="inherit_id" ref="view_field_partner_rates_form"/>
        <field name="arch" type="xml"><xpath expr="//sheet" position="before"><header><button name="action_enrol_field_contractor" type="object" string="הפעלת פורטל קבלן ושיבוץ" groups="field_work_photos.group_field_finance" confirm="יש לאמת את שם איש הקשר וכתובת הדוא״ל. להפעיל פורטל לעבודות שישויכו אליו בלבד?"/></header></xpath>
            <xpath expr="//field[@name='phone']" position="after"><field name="email" widget="email"/></xpath>
            <xpath expr="//div[hasclass('o_field_rates_content')]/p[1]" position="replace"><p>המדרגה נבחרת לפי סכום העסקה לפני מע״מ. בעבודות חדשות האחוז חל על בסיס העמלה לאחר ניכוי הוצאות העסק והחומרים.</p></xpath>
            <xpath expr="//p[contains(text(),'האחוז חל על כל סכום העסקה')]" position="replace"><p>האחוז חל על מלוא בסיס העמלה, ולא רק על החלק שמעל גבול המדרגה. כל הסכומים לפני מע״מ. אפשר להזין אחוז בין 0 ל־100.</p></xpath>
        </field>
    </record>
    <record id="action_field_collections" model="ir.actions.act_window">
        <field name="domain">[('is_field_service','=',True),('field_customer_due','&gt;',0),('field_dispatch_code','!=','paid')]</field>
        <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('view_field_collection_list')}),(0,0,{'view_mode':'form','view_id':ref('view_field_workcard')})]"/>
    </record>
    <record id="action_field_payouts" model="ir.actions.act_window"><field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('view_field_payout_list')}),(0,0,{'view_mode':'form','view_id':ref('view_field_workcard')})]"/></record>
    <record id="action_field_work_attention" model="ir.actions.act_window"><field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('view_field_lead_list')}),(0,0,{'view_mode':'form','view_id':ref('view_field_workcard')})]"/></record>
    <record id="action_field_collections_paid" model="ir.actions.act_window">
        <field name="name">גבייה שהושלמה / שולם</field><field name="res_model">crm.lead</field><field name="view_mode">list,form</field>
        <field name="domain">[('is_field_service','=',True),('field_dispatch_code','=','paid')]</field>
        <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('view_field_collection_list')}),(0,0,{'view_mode':'form','view_id':ref('view_field_workcard')})]"/>
    </record>
    <menuitem id="menu_field_collections_root" name="גבייה ותשלומים" parent="menu_field_service_root" sequence="20" groups="field_work_photos.group_field_dispatcher"/>
    <record id="menu_field_collections" model="ir.ui.menu"><field name="parent_id" ref="menu_field_collections_root"/></record>
    <menuitem id="menu_field_collections_paid" name="גבייה שהושלמה / שולם" parent="menu_field_collections_root" action="action_field_collections_paid" sequence="20" groups="field_work_photos.group_field_dispatcher"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_field_work_home" inherit_id="portal.portal_my_home" name="עבודות השטח שלי">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t groups="field_work_photos.group_field_contractor" t-call="portal.portal_docs_entry">
                <t t-set="title">עבודות השטח שלי</t><t t-set="url" t-value="'/my/field-work'"/>
                <t t-set="text">פרטי עבודה, תמונות ודיווח לבדיקת התפעול</t>
                <t t-set="placeholder_count" t-value="'field_work_count'"/><t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>
    <template id="portal_field_work_list" name="רשימת עבודות לקבלן">
        <t t-call="portal.portal_layout">
            <div class="container o_field_ui o_field_portal py-4" dir="rtl">
                <header class="o_field_panel o_field_portal_heading"><p class="o_field_eyebrow">עבודות שטח</p><h1>עבודות השטח שלי</h1><p>בחר עבודה לצפייה בפרטים, לתיעוד ולשליחת הדיווח לבדיקה.</p></header>
                <nav class="o_field_tabs" aria-label="סינון העבודות">
                    <a t-att-href="'/my/field-work?scope=active'" t-att-class="'active' if scope == 'active' else ''" t-att-aria-current="'page' if scope == 'active' else None">לביצוע <span t-out="counts['active']"/></a>
                    <a href="/my/field-work?scope=pending" t-att-class="'active' if scope == 'pending' else ''" t-att-aria-current="'page' if scope == 'pending' else None">בבדיקה <span t-out="counts['pending']"/></a>
                    <a href="/my/field-work?scope=completed" t-att-class="'active' if scope == 'completed' else ''" t-att-aria-current="'page' if scope == 'completed' else None">הסתיימו <span t-out="counts['completed']"/></a>
                </nav>
                <div t-if="not tasks" class="o_field_panel"><h2>אין כרגע עבודות ברשימה הזאת</h2><p>עבודות חדשות יופיעו כאן לאחר שיבוץ על ידי התפעול.</p></div>
                <div class="o_field_job_grid">
                    <t t-foreach="tasks" t-as="task">
                        <a t-att-href="'/my/field-work/%s' % task.id" class="o_field_panel o_field_job_link">
                            <span class="o_field_status" t-out="'בוטלה' if task.state == '1_canceled' else dict(task._fields['field_review_state'].selection).get(task.field_review_state)"/>
                            <h2 t-out="task.name"/><p t-out="task.field_customer_name"/>
                            <p t-out="task.field_site_address"/><p><span t-field="task.field_visit_at" t-options="{'format': 'dd/MM/yyyy HH:mm'}"/></p>
                            <strong t-if="task.field_review_state == 'changes_requested'">נדרש עדכון הדיווח</strong>
                            <span class="o_field_job_cta">פתיחת העבודה ←</span>
                        </a>
                    </t>
                </div>
                <div class="o_portal_pager d-flex justify-content-center mt-4"><t t-call="portal.pager"/></div>
            </div>
        </t>
    </template>
    <template id="portal_field_work_detail" name="דיווח עבודת שטח">
        <t t-call="portal.portal_layout">
            <div class="container o_field_ui o_field_portal py-4" dir="rtl">
                <a href="/my/field-work" class="o_field_back">→ חזרה לעבודות שלי</a>
                <header class="o_field_panel o_field_portal_heading">
                    <p class="o_field_eyebrow">עבודת שטח</p><h1 t-out="task.name"/>
                    <span class="o_field_status" t-out="'בוטלה' if task.state == '1_canceled' else dict(task._fields['field_review_state'].selection).get(task.field_review_state)"/>
                </header>
                <div t-if="error" class="alert alert-danger o_field_message" role="alert"><strong t-out="error"/><p>הקבצים שנבחרו בבקשה הזאת לא נשמרו. בדוק ובחר אותם מחדש.</p></div>
                <div t-if="notice and not error" class="o_field_message o_field_message_success" role="status" t-out="notice"/>
                <section class="o_field_panel">
                    <h2>פרטי העבודה</h2>
                    <dl class="o_field_job_details">
                        <div><dt>לקוח</dt><dd t-out="task.field_customer_name"/></div>
                        <div><dt>מועד ביצוע</dt><dd><span t-field="task.field_visit_at" t-options="{'format': 'dd/MM/yyyy HH:mm'}"/></dd></div>
                        <div><dt>כתובת</dt><dd t-out="task.field_site_address"/></div>
                        <div t-if="task.field_site_contact"><dt>איש קשר בשטח</dt><dd t-out="task.field_site_contact"/></div>
                        <div t-if="task.field_site_unit"><dt>דירה / קומה</dt><dd t-out="task.field_site_unit"/></div>
                        <div><dt>טלפון</dt><dd><bdi t-out="task.field_customer_phone"/></dd></div>
                    </dl>
                    <div class="o_field_contact_actions"><a t-if="task.field_customer_phone" t-att-href="phone_url" class="btn btn-outline-primary">חיוג ללקוח</a><a t-if="task.field_site_address" t-att-href="navigation_url" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary">ניווט לכתובת</a></div>
                    <p t-if="task.field_access_instructions" class="o_field_work_description"><strong>הוראות כניסה והגעה: </strong><t t-out="task.field_access_instructions"/></p>
                    <p class="o_field_work_description" t-out="task.field_work_description"/>
                </section>
                <div t-if="task.field_review_state == 'pending'" class="o_field_message" role="status">הדיווח ממתין לבדיקת התפעול. הדיווח והתמונות נעולים בזמן הבדיקה.</div>
                <div t-if="task.field_review_state == 'approved'" class="o_field_message o_field_message_success" role="status">הביצוע אושר על ידי התפעול.</div>
                <div t-if="task.field_review_state == 'changes_requested'" class="o_field_message o_field_message_warning" role="status"><strong t-out="'הנחיות להמשך טיפול' if task.field_visit_result in ('followup','not_done') else 'מה צריך לתקן?'"/><p t-out="task.field_review_note"/></div>
                <form t-att-action="'/my/field-work/%s/report' % task.id" method="post" enctype="multipart/form-data" data-field-report="1" class="o_field_report_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <section class="o_field_panel o_field_visit_report">
                        <h2>דיווח הביקור</h2>
                        <div class="mb-3">
                            <label for="field_visit_result" class="form-label">תוצאת הביקור <span t-if="editable">(חובה להגשה)</span></label>
                            <select t-if="editable" name="field_visit_result" id="field_visit_result" class="form-select" required="required">
                                <option value="">בחירת תוצאה</option>
                                <option t-foreach="[('completed','הושלם'),('followup','נדרש המשך'),('not_done','לא בוצע')]" t-as="result" t-att-value="result[0]" t-att-selected="report['field_visit_result'] == result[0]" t-out="result[1]"/>
                            </select>
                            <p t-else="" t-out="dict(task._fields['field_visit_result'].selection).get(task.field_visit_result)"/>
                        </div>
                        <div class="mb-3" data-visit-summary="1">
                            <label for="field_visit_summary" class="form-label">מה בוצע בפועל? <span t-if="editable">(חובה כשהעבודה הושלמה)</span></label>
                            <textarea t-if="editable" id="field_visit_summary" name="field_visit_summary" rows="3" maxlength="4000" class="form-control" placeholder="למשל: הוחלף הברז ונבדק שאין נזילות" t-out="report['field_visit_summary']"/>
                            <p t-else="" class="o_field_work_description" t-out="task.field_visit_summary or 'לא נרשם סיכום'"/>
                        </div>
                        <div class="mb-3" data-visit-reason="1" t-if="editable or task.field_visit_result in ('followup', 'not_done')">
                            <label for="field_visit_reason" class="form-label">מה מנע השלמה ומה נדרש להמשך? <span t-if="editable">(חובה בביקור שלא הושלם)</span></label>
                            <textarea t-if="editable" id="field_visit_reason" name="field_visit_reason" rows="3" maxlength="4000" class="form-control" placeholder="למשל: הלקוח לא היה בבית; נדרש תיאום ביקור נוסף" t-out="report['field_visit_reason']"/>
                            <p t-else="" class="o_field_work_description" t-out="task.field_visit_reason"/>
                        </div>
                        <div class="mb-3">
                            <label for="field_visit_notes" class="form-label">הערות נוספות (רשות)</label>
                            <textarea t-if="editable" id="field_visit_notes" name="field_visit_notes" rows="2" maxlength="4000" class="form-control" t-out="report['field_visit_notes']"/>
                            <p t-else="" class="o_field_work_description" t-out="task.field_visit_notes or '—'"/>
                        </div>
                        <p t-if="editable" class="o_field_help">ביקור שלא הושלם יישלח לתפעול להמשך טיפול ולא יסמן את העבודה כהושלמה.</p>
                    </section>
                    <section class="o_field_panel">
                        <h2>תיעוד הביצוע</h2>
                        <p data-report-summary="1" role="status" aria-live="polite"><t t-out="len(galleries['before'])"/> תמונות לפני · <t t-out="len(galleries['after'])"/> תמונות אחרי</p>
                        <p class="o_field_help">עד 5 תמונות בכל אזור. בהגשת עבודה שהושלמה נדרשת לפחות תמונה אחת לפני ותמונה אחת אחרי.</p>
                        <div class="o_field_photo_grid">
                            <t t-foreach="[('before', 'לפני ביצוע'), ('after', 'אחרי ביצוע')]" t-as="area">
                                <div class="o_field_gallery" t-att-data-kind="area[0]">
                                    <h3 t-out="area[1]"/>
                                    <div class="o_field_gallery_items" data-saved-photos="1">
                                        <t t-foreach="galleries[area[0]]" t-as="photo">
                                            <div class="o_field_gallery_item" t-att-data-photo-key="photo['key']">
                                                <a t-att-href="'/my/field-work/%s/photo/%s/%s' % (task.id, area[0], photo['id'])" target="_blank" rel="noopener" data-zoom-photo="1" t-att-aria-label="'הגדלת תמונה %s, %s' % (photo_index + 1, area[1])">
                                                    <img t-att-src="'/my/field-work/%s/photo/%s/%s' % (task.id, area[0], photo['id'])" t-att-alt="'%s — תמונה %s' % (area[1], photo_index + 1)" class="o_field_gallery_image"/>
                                                </a>
                                                <label t-if="editable" class="o_field_photo_remove"><input type="checkbox" name="remove_photo" t-att-value="photo['key']"/> הסרה בשמירה הבאה</label>
                                                <span class="o_field_help">נשמרה במערכת</span>
                                            </div>
                                        </t>
                                    </div>
                                    <p t-if="not galleries[area[0]]" data-photo-placeholder="1" class="o_field_photo_placeholder">עדיין לא נשמרו תמונות</p>
                                    <div data-new-photos="1" class="o_field_gallery_items"/>
                                    <label t-if="editable" t-att-for="'field_%s_image' % area[0]" class="form-label">הוספת תמונות <t t-out="area[1]"/></label>
                                    <input t-if="editable" t-att-id="'field_%s_image' % area[0]" t-att-name="'field_%s_image' % area[0]" type="file" multiple="multiple" accept="image/jpeg,image/png,image/webp" class="form-control" t-att-aria-describedby="'photo-error-%s' % area[0]"/>
                                    <button t-if="editable" type="button" data-select-photo="1" class="btn btn-outline-primary" t-att-aria-label="'הוספת תמונות %s' % area[1]" hidden="hidden">הוספת תמונות מהמצלמה או מהגלריה</button>
                                    <p t-att-id="'photo-error-%s' % area[0]" data-file-error="1" class="o_field_inline_error" role="alert" hidden="hidden"/>
                                </div>
                            </t>
                        </div>
                        <p t-if="editable" class="o_field_help">JPG, PNG או WebP, עד 12MB לתמונה. תמונות חדשות והסרות יישמרו רק לאחר לחיצה על שמירה או שליחת דיווח.</p>
                    </section>
                    <div t-if="editable" class="o_field_portal_actions">
                        <button type="submit" name="action" value="submit" class="btn btn-primary" data-report-submit="1">שליחת דיווח לבדיקה</button>
                        <button type="submit" name="action" value="upload" formnovalidate="formnovalidate" class="btn btn-outline-secondary" data-report-save="1">שמירה והמשך מאוחר יותר</button>
                    </div>
                </form>
                <dialog data-photo-dialog="1" class="o_field_photo_dialog"><button type="button" class="btn btn-outline-secondary" data-close-photo="1">סגירת התמונה</button><img alt="תמונת תיעוד מוגדלת"/></dialog>
            </div>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_field_lead_form" model="ir.ui.view">
        <field name="name">crm.lead.field.service.form</field><field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="פניית עבודת שטח">
                <header>
                    <button name="action_dispatch_field_work" string="שיבוץ ופתיחת משימת שטח" type="object" class="oe_highlight" invisible="field_dispatch_code != 'schedule'"/>
                    <field name="stage_id" widget="statusbar" domain="[('field_dispatch_code', '!=', False)]" options="{'clickable': True}"/>
                </header>
                <sheet>
                    <field name="is_field_service" invisible="1"/><field name="field_dispatch_code" invisible="1"/>
                    <field name="type" invisible="1"/><field name="team_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_field_task" type="object" class="oe_stat_button" icon="fa-wrench" invisible="field_task_count == 0">
                            <field name="field_task_count" widget="statinfo" string="משימת שטח"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="למשל: החלפת ברז במטבח" required="1"/></h1></div>
                    <group>
                        <group string="פרטי הלקוח והעבודה">
                            <field name="partner_id" string="לקוח"/>
                            <field name="contact_name" string="איש קשר"/>
                            <field name="phone" string="טלפון לתיאום"/>
                            <field name="field_site_address" placeholder="רחוב, מספר, עיר ופרטי הגעה"/>
                            <field name="field_work_description" placeholder="מה צריך לבצע? הטקסט יוצג לקבלן"/>
                        </group>
                        <group string="הצעת מחיר ושיבוץ">
                            <field name="field_quote_number"/>
                            <field name="field_contractor_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="field_visit_at"/>
                            <field name="user_id" string="אחראי טיפול"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="field_dispatch_code != 'schedule'">
                        לשיבוץ יש לבחור לקוח וקבלן ולהזין מועד, כתובת ותיאור עבודה. הקבלן יראה את המשימה בפורטל שלו.
                    </div>
                    <div class="alert alert-success" role="status" invisible="field_dispatch_code != 'completed'">
                        דיווח השטח אושר. העבודה ממתינה לטיפול בתשלום; אישור העבודה אינו אישור קבלת תשלום.
                    </div>
                    <notebook><page string="הערות פנימיות"><field name="description" placeholder="הערות פנימיות שאינן מוצגות לקבלן"/></page></notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_field_lead_list" model="ir.ui.view">
        <field name="name">crm.lead.field.service.list</field><field name="model">crm.lead</field>
        <field name="arch" type="xml"><list string="פניות עבודות שטח">
            <field name="name"/><field name="partner_id"/><field name="stage_id"/>
            <field name="field_contractor_id"/><field name="field_visit_at"/><field name="field_site_address"/>
        </list></field>
    </record>
    <record id="view_field_lead_kanban" model="ir.ui.view">
        <field name="name">crm.lead.field.service.kanban</field><field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" quick_create="false" group_create="false" group_edit="false" group_delete="false">
                <field name="name"/><field name="partner_id"/><field name="field_contractor_id"/><field name="field_visit_at"/>
                <templates><t t-name="card">
                    <div class="fw-bold fs-5 mb-2"><field name="name"/></div>
                    <div><field name="partner_id"/></div>
                    <div class="text-muted mt-2"><field name="field_contractor_id"/></div>
                    <div class="text-muted"><field name="field_visit_at"/></div>
                </t></templates>
            </kanban>
        </field>
    </record>
    <record id="action_field_service_leads" model="ir.actions.act_window">
        <field name="name">פניות ושיבוץ עבודות</field><field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form</field><field name="domain">[('is_field_service', '=', True)]</field>
        <field name="context">{'default_is_field_service': True, 'default_type': 'opportunity', 'field_service_pipeline': True}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">פתיחת פנייה חדשה ושיבוץ לקבלן</p></field>
    </record>
    <record id="action_field_service_leads_kanban" model="ir.actions.act_window.view">
        <field name="sequence">1</field><field name="view_mode">kanban</field><field name="view_id" ref="view_field_lead_kanban"/><field name="act_window_id" ref="action_field_service_leads"/>
    </record>
    <record id="action_field_service_leads_list" model="ir.actions.act_window.view">
        <field name="sequence">2</field><field name="view_mode">list</field><field name="view_id" ref="view_field_lead_list"/><field name="act_window_id" ref="action_field_service_leads"/>
    </record>
    <record id="action_field_service_leads_form" model="ir.actions.act_window.view">
        <field name="sequence">3</field><field name="view_mode">form</field><field name="view_id" ref="view_field_lead_form"/><field name="act_window_id" ref="action_field_service_leads"/>
    </record>
    <menuitem id="menu_field_service_root" name="עבודות שטח" sequence="15" groups="field_work_photos.group_field_dispatcher"/>
    <menuitem id="menu_field_service_leads" name="פניות ושיבוץ" parent="menu_field_service_root" action="action_field_service_leads" sequence="10"/>
    <record id="view_task_form_dispatch_details" model="ir.ui.view">
        <field name="name">project.task.form.dispatch.details</field><field name="model">project.task</field><field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml"><xpath expr="//notebook" position="inside">
            <page string="פרטי שיבוץ" invisible="not field_service_lead_id" groups="base.group_user">
                <group><field name="field_service_lead_id"/><field name="field_contractor_id"/>
                    <field name="field_visit_at"/><field name="field_site_address"/>
                    <field name="field_customer_name"/><field name="field_customer_phone"/>
                    <field name="field_work_description"/>
                </group>
            </page>
        </xpath></field>
    </record>
</odoo>
